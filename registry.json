{
  "plugins": [
    {
      "name": "bili-up",
      "title": "B站荐片",
      "author": "Mopie",
      "description": "关注影评 UP，从标题识别片名并展示 TMDB 海报。不自动订阅。",
      "latestVersion": "0.1.5",
      "logoUrl": "",
      "githubUrl": "https://github.com/yl948/mopie-plugins",
      "helpDocUrl": "https://github.com/yl948/mopie-plugins/tree/main/plugins/bili-up",
      "payImageUrl": "",
      "versions": [
        {
          "version": "0.1.5",
          "changeLog": "同时提供 ARM 和 x86 程序。",
          "updatedAt": "2026-10-18T16:10:00Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/bili-up.zip"
        },
        {
          "version": "0.1.4",
          "changeLog": "海报列表分页；下一页继续拉更早的投稿。",
          "updatedAt": "2026-09-24T08:40:22Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/bili-up.zip"
        }
      ],
      "configField": [
        {
          "fieldName": "fetch_count",
          "fieldType": "Number",
          "label": "每个 UP 拉取数量",
          "helperText": "刷新时每个关注 UP 拉最近多少条投稿，1–100，默认 20。",
          "defaultValue": 20
        },
        {
          "fieldName": "proxy",
          "fieldType": "String",
          "label": "HTTP 代理",
          "helperText": "拉 B 站投稿用。留空则使用系统 TMDB 代理。",
          "defaultValue": ""
        }
      ],
      "dependencies": {
        "appVersion": ">=1.0.0"
      }
    },
    {
      "name": "explore-services",
      "title": "探索服务聚合",
      "author": "Mopie",
      "description": "聚合 Bilibili、腾讯视频、CCTV、芒果TV、咪咕视频和 Bangumi 的公开影视探索目录。",
      "latestVersion": "0.3.5-beta",
      "logoUrl": "",
      "githubUrl": "https://github.com/yl948/mopie-plugins",
      "helpDocUrl": "https://github.com/yl948/mopie-plugins/tree/main/plugins/explore-services",
      "payImageUrl": "",
      "versions": [
        {
          "version": "0.3.5-beta",
          "changeLog": "同时提供 ARM 和 x86 程序。",
          "updatedAt": "2026-10-18T16:00:22Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/explore-services.zip"
        },
        {
          "version": "0.3.4-beta",
          "changeLog": "同步本地正在使用的版本。",
          "updatedAt": "2026-09-24T08:40:22Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/explore-services.zip"
        }
      ],
      "configField": [
        {
          "fieldName": "bilibili_enabled",
          "fieldType": "Bool",
          "label": "启用 Bilibili",
          "defaultValue": true
        },
        {
          "fieldName": "tencent_enabled",
          "fieldType": "Bool",
          "label": "启用腾讯视频",
          "defaultValue": true
        },
        {
          "fieldName": "cctv_enabled",
          "fieldType": "Bool",
          "label": "启用 CCTV",
          "defaultValue": true
        },
        {
          "fieldName": "cctv_use_tmdb_cover",
          "fieldType": "Bool",
          "label": "CCTV 使用 TMDB 封面",
          "helperText": "当启用时，CCTV 节目将通过标题搜索 TMDB 获取更清晰的封面图（需填写 TMDB API Key）。",
          "defaultValue": false
        },
        {
          "fieldName": "mango_enabled",
          "fieldType": "Bool",
          "label": "启用芒果TV",
          "defaultValue": true
        },
        {
          "fieldName": "migu_enabled",
          "fieldType": "Bool",
          "label": "启用咪咕视频",
          "defaultValue": true
        },
        {
          "fieldName": "bangumi_enabled",
          "fieldType": "Bool",
          "label": "启用 Bangumi",
          "defaultValue": true
        },
        {
          "fieldName": "bangumi_proxy",
          "fieldType": "String",
          "label": "Bangumi HTTP 代理",
          "helperText": "仅用于访问 api.bgm.tv；例如 http://127.0.0.1:7890，留空则直连。",
          "defaultValue": ""
        }
      ],
      "dependencies": {
        "appVersion": ">=1.0.0"
      }
    },
    {
      "name": "javbus",
      "title": "JavBus 搜索",
      "author": "Mopie",
      "description": "按番号搜索 JavBus 影片资料并查看、复制磁力链接，不会自动提交下载。",
      "latestVersion": "0.1.2",
      "logoUrl": "",
      "githubUrl": "https://github.com/yl948/mopie-plugins",
      "helpDocUrl": "https://github.com/yl948/mopie-plugins/tree/main/plugins/javbus",
      "payImageUrl": "",
      "versions": [
        {
          "version": "0.1.2",
          "changeLog": "更换插件 logo（扁平风）。",
          "updatedAt": "2026-10-28T18:00:00Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/javbus.zip"
        },
        {
          "version": "0.1.1",
          "changeLog": "更换插件 logo。",
          "updatedAt": "2026-10-28T17:00:00Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/javbus.zip"
        },
        {
          "version": "0.1.0",
          "changeLog": "同步本地正在使用的版本。",
          "updatedAt": "2026-09-24T08:40:22Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/javbus.zip"
        }
      ],
      "configField": [
        {
          "fieldName": "proxy",
          "fieldType": "String",
          "label": "HTTP 代理",
          "helperText": "仅用于 JavBus 请求；留空则直连。",
          "defaultValue": ""
        },
        {
          "fieldName": "cookie",
          "fieldType": "String",
          "label": "JavBus Cookie",
          "helperText": "浏览器确认年龄后的 Cookie。留空则只访问公开列表。保存在插件配置中。",
          "defaultValue": ""
        }
      ],
      "dependencies": {
        "appVersion": ">=1.0.0"
      }
    },
    {
      "name": "missav_metadata",
      "title": "MissAV 元数据",
      "author": "Mopie",
      "description": "独立 NSFW 元数据提供器",
      "latestVersion": "0.2.0",
      "logoUrl": "",
      "githubUrl": "https://github.com/yl948/mopie-plugins",
      "helpDocUrl": "https://github.com/yl948/mopie-plugins/tree/main/plugins/missav_metadata",
      "payImageUrl": "",
      "versions": [
        {
          "version": "0.2.0",
          "changeLog": "同步本地正在使用的版本。",
          "updatedAt": "2026-09-24T08:40:22Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://raw.githubusercontent.com/yl948/mopie-plugins/main/dist/missav_metadata.zip"
        }
      ],
      "configField": [
        {
          "fieldName": "enabled",
          "fieldType": "Bool",
          "label": "启用插件",
          "defaultValue": false
        },
        {
          "fieldName": "base_url",
          "fieldType": "String",
          "label": "站点地址",
          "helperText": "如 https://missav.ws",
          "defaultValue": "https://missav.ws",
          "required": true
        },
        {
          "fieldName": "language_prefix",
          "fieldType": "Enum",
          "label": "页面语言",
          "defaultValue": "en",
          "enumValues": {
            "en": "English",
            "cn": "简体中文"
          },
          "required": true
        },
        {
          "fieldName": "proxy",
          "fieldType": "String",
          "label": "代理地址",
          "helperText": "HTTP代理；留空直连"
        },
        {
          "fieldName": "flaresolverr_url",
          "fieldType": "String",
          "label": "FlareSolverr 地址",
          "helperText": "如 http://ip:8191/v1",
          "required": true
        }
      ],
      "dependencies": {
        "appVersion": ">=1.0.0"
      }
    },
    {
