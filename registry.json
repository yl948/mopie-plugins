    {
      "name": "tmdb_proxy",
      "title": "TMDB 代理",
      "author": "Mopie",
      "description": "免费部署 TMDB API 代理到 Vercel，国内直连无需梯子。支持自定义域名、连接测试、状态检测。",
      "latestVersion": "0.1.0",
      "logoUrl": "",
      "githubUrl": "https://github.com/imaliang/tmdb-proxy",
      "helpDocUrl": "https://github.com/yl948/mopie-plugins/tree/main/plugins/tmdb_proxy",
      "payImageUrl": "",
      "versions": [
        {
          "version": "0.1.0",
          "changeLog": "初始发布",
          "updatedAt": "2026-09-05T17:21:47Z",
          "minAppVersion": "1.0.0",
          "downloadUrl": "https://github.com/yl948/mopie-plugins/releases/download/tmdb_proxy-0.1.0/tmdb_proxy.zip"
        }
      ],
      "configField": [
        {
          "fieldName": "api_key",
          "fieldType": "String",
          "label": "TMDB API Key",
          "helperText": "在 themoviedb.org/settings/api 获取，v3 auth 格式",
          "required": true
        },
        {
          "fieldName": "proxy_mode",
          "fieldType": "Enum",
          "label": "代理方式",
          "helperText": "选择如何访问 TMDB API",
          "defaultValue": "vercel",
          "enumValues": {
            "vercel": "Vercel 反代（推荐，免费）",
            "http": "HTTP 代理（已有代理服务器时使用）"
          },
          "required": true
        },
        {
          "fieldName": "vercel_domain",
          "fieldType": "String",
          "label": "Vercel 自定义域名",
          "helperText": "部署到 Vercel 后绑定的域名，如 tmdb.yourdomain.com"
        },
        {
          "fieldName": "http_proxy",
          "fieldType": "String",
          "label": "HTTP 代理地址",
          "helperText": "代理方式选 HTTP 时填写，如 http://192.168.1.1:7890"
        }
      ],
      "dependencies": {
        "appVersion": ">=1.0.0"
      }
    },
